{
  "name": "@leadtruffle/custom-booking-adapter-kit",
  "private": true,
  "type": "module",
  "files": [
    "src",
    "README.md",
    "CONTRACT.md",
    "IMPLEMENTATION_PROMPT.md",
    "openapi.json",
    "examples.json",
    "tsconfig.json",
    "vitest.config.ts",
    "biome.json",
    "LICENSE",
    ".nvmrc",
    "public-files.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "fixture": "node --import tsx src/runFixture.ts",
    "validate": "node --import tsx src/validate.ts",
    "generate": "node --import tsx src/generate.ts",
    "check:generated": "node --import tsx src/generate.ts --check",
    "test": "vitest run",
    "tsc": "tsc --noEmit",
    "format": "biome format src",
    "check": "npm run check:generated && npm run tsc && npm run format && npm test"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "express": "4.22.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "ajv": "6.15.0",
    "@biomejs/biome": "2.5.6",
    "@types/express": "4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.22.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "description": "Typed adapter starter, contract examples and synthetic tests for LeadTruffle custom booking integrations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeadTruffle/custom-booking-api-integration-examples.git"
  }
}
